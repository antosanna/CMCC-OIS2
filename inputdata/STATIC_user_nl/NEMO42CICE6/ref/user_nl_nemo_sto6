!!>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
!! NEMO/OCE  Configuration namelist : overwrite default values defined in SHARED/namelist_ref
!!>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
!                         AGRIF ICE configuration                      !
!!======================================================================
!!              ***  Domain & Run management namelists  ***           !!
!!                                                                    !!
!!   namrun       parameters of the run
!!   namdom       space and time domain
!!   namcfg       parameters of the configuration                       (default: user defined GYRE)
!!   namwad       Wetting and drying                                    (default: OFF)
!!   namtsd       data: temperature & salinity                          (default: OFF)
!!   namcrs       coarsened grid (for outputs and/or TOP)               (ln_crs =T)
!!   namc1d       1D configuration options                              ("key_c1d")
!!   namc1d_dyndmp 1D newtonian damping applied on currents             ("key_c1d")
!!   namc1d_uvd   1D data (currents)                                    ("key_c1d")
!!======================================================================
!
!-----------------------------------------------------------------------
&namrun        !   parameters of the run
!-----------------------------------------------------------------------
	cn_exp = _CNRESTIN_  !  experiment name
	nn_it000 = _NNIT000_  !  first time step
	nn_itend = _NNITEND_  !  last  time step
	nn_date0 = _NNDATE0_  !  date at nit_0000 (format yyyymmdd)
   nn_leapy    =       1       !  Leap year calendar (1) or not (0)
   nn_istate   =       0       !  output the initial state (1) or not (0)
	ln_rstart = ._TORESTART_.  !  start from rest (F) or from a restart file (T)
	nn_rstctl = 0  !  restart control ==> activated only if ln_rstart=T
	cn_ocerst_in = "_CNRESTIN___LASTEPWE__restart"  !  suffix of ocean restart name (input)
   cn_ocerst_indir = "."       !  directory from which to read input ocean restarts
   cn_ocerst_out = "restart"   !  suffix of ocean restart name (output)
   cn_ocerst_outdir = "."      !  directory in which to write output ocean restarts
	nn_stock = _NSTOCKS_  !  frequency of creation of a restart file
   ln_clobber  = .true.        !  clobber (overwrite) an existing file
/
!-----------------------------------------------------------------------
&namdom        !   time and space domain
!-----------------------------------------------------------------------
   ln_linssh   = .false.    !  =T  linear free surface  ==>>  model level are fixed in time
   !
   rn_Dt      = _TSTEP_.        !  time step for the dynamics and tracer
   rn_atfp     =    0.1    !  asselin time filter parameter
   !
   ln_meshmask = .false.   !  =T create a mesh file
/
!-----------------------------------------------------------------------
&namcfg        !   parameters of the configuration                      (default: user defined GYRE)
!-----------------------------------------------------------------------
   ln_read_cfg = .true.     !  (=T) read the domain configuration file
      cn_domcfg = "ORCA025L75_domain_cfg"  ! domain configuration filename
      ln_closea    = .true. !  (=T => fill namclo)
/
!-----------------------------------------------------------------------
&namtile        !   parameters of the tiling
!-----------------------------------------------------------------------
   ln_tile = .false.     !  Use tiling (T) or not (F)
/
!-----------------------------------------------------------------------
&namclo        !   parameters of the closed sea (cs) behavior                (default: OFF)
!-----------------------------------------------------------------------
   ln_maskcs = .false.        ! (=T) cs are masked ; So, in this case ln_mask_csundef and ln_clo_rnf have no effect.
   ln_mask_csundef = .true.   ! (=T) undefined closed seas are masked ;
   ln_clo_rnf = .false.        ! (=T) river mouth specified in domain_cfg.nc masks (rnf and emp case) are added to the runoff mask.
/
!-----------------------------------------------------------------------
&namtsd        !    Temperature & Salinity Data                         (default: OFF)
!-----------------------------------------------------------------------
   !                       ! =T  read T-S fields for:
   ln_tsd_init = .true.          !  ocean initialisation
   ln_tsd_dmp  = .true.         !  T-S restoring   (see namtra_dmp)

   cn_dir = '/work/cmcc/cp1/CPS/CMCC-OIS2/inputdata/STATIC_DA_NEMO42/OTHER_FORCINGS/T3D/'      !  root directory for the T-S data location
   !___________!____________________________!___________________!___________!_____________!________!___________!__________________!__________!_______________!
   !           !  file name                 ! frequency (hours) ! variable  ! time interp.!  clim  ! 'yearly'/ ! weights filename ! rotation ! land/sea mask !
   !           !                            !  (if <0  months)  !   name    !   (logical) !  (T/F) ! 'monthly' !                  ! pairing  !    filename   !
   sn_tem = 'int_tem_ORCA025',     -12            ,'tem'   ,   .false.    , .false. , 'yearly'  ,    ''    ,    ''    ,    ''
   sn_sal = 'vosaline_EN4-ORCA025'    ,     -1            ,'vosaline'       ,   .false.    , .false. , 'monthly'  ,    ''    ,    ''    ,    ''
/
!!======================================================================
!!            ***  Surface Boundary Condition namelists  ***          !!
!!                                                                    !!
!!   namsbc          surface boundary condition manager                 (default: NO selection)
!!   namsbc_flx      flux               formulation                     (ln_flx     =T)
!!   namsbc_blk      Bulk formulae formulation                          (ln_blk     =T)
!!   namsbc_cpl      CouPLed            formulation                     ("key_oasis3" )
!!   namsbc_sas      Stand-Alone Surface module                         (SAS_SRC  only)
!!   namtra_qsr      penetrative solar radiation                        (ln_traqsr  =T)
!!   namsbc_rnf      river runoffs                                      (ln_rnf     =T)
!!   namsbc_isf      ice shelf melting/freezing                         (ln_isfcav  =T : read (ln_read_cfg=T) or set or usr_def_zgr )
!!   namsbc_iscpl    coupling option between land ice model and ocean   (ln_isfcav  =T)
!!   namsbc_apr      Atmospheric Pressure                               (ln_apr_dyn =T)
!!   namsbc_ssr      sea surface restoring term (for T and/or S)        (ln_ssr     =T)
!!   namsbc_wave     external fields from wave model                    (ln_wave    =T)
!!   namberg         iceberg floats                                     (ln_icebergs=T)
!!======================================================================
!
!-----------------------------------------------------------------------
&namsbc        !   Surface Boundary Condition manager                   (default: NO selection)
!-----------------------------------------------------------------------
	nn_fsbc = _NNFSBC_  !  frequency of surface boundary condition computation
	ln_cpl = .true.  !  atmosphere coupled   formulation
        ln_blk = .false.    !  Bulk formulation                          (T => fill namsbc_blk )
	nn_ice = 0  !  =0 no ice boundary condition from LIM model
        ln_traqsr   = .true.    !  Light penetration in the ocean            (T => fill namtra_qsr)
	ln_rnf = .true.  !  runoffs
	ln_ssr = ._SSRTF_.  !  Sea Surface Restoring on T and/or S
	nn_fwb = 4  !  FreshWater Budget: =0 unchecked, =1 global mean of e-p-r set to zero at each time step
/
!-----------------------------------------------------------------------
&nam_fwb
!-----------------------------------------------------------------------
    slafwb_dir='/work/cmcc/cp1/CPS/CMCC-OIS2/inputdata/STATIC_DA_NEMO42/sla_trend/'
/
!
!-----------------------------------------------------------------------
&namtra_qsr    !   penetrative solar radiation                          (ln_traqsr =T)
!-----------------------------------------------------------------------
   ln_qsr_rgb  = .true.       !  RGB light penetration (Red-Green-Blue)
   ln_qsr_2bd  = .false.      !  2BD light penetration (two bands)
   nn_chldta   =      1       !  RGB : Chl data (=1) or cst value (=0)
   cn_dir      = './'  !  root directory for the chlorophyl data location
   !___________!__________________________________!___________________!___________!_____________!________!___________!__________________!__________!_______________!
   !           !  file name                       ! frequency (hours) ! variable  ! time interp.!  clim  ! 'yearly'/ ! weights filename ! rotation ! land/sea mask !
   !           !                                  !  (if <0  months)  !   name    !   (logical) !  (T/F) ! 'monthly' !                  ! pairing  !    filename   !
   sn_chl      = 'ORCA025L75_ESACCIv4_chl_nomask' ,       -1          ,   'chl'   ,    .true.   , .true. , 'yearly'  , '' , '' , ''
/
!-----------------------------------------------------------------------
&namsbc_ssr    !   surface boundary condition : sea surface restoring   (ln_ssr =T)
!-----------------------------------------------------------------------
!-----------------------------------------------------------------------
   nn_sstr     =     1     !  add a retroaction term to the surface heat flux (=1) or not (=0)
   rn_dqdt     = -200.   !  magnitude of the retroaction on temperature   [W/m2/K]
   nn_sssr     =     2     !  add a damping term to the surface freshwater flux (=2)
   rn_deds     =  -166.67  !  magnitude of the damping on salinity   [mm/day]
   ln_sssr_bnd =  .true.   !  flag to bound erp term (associated with nn_sssr=2)
   rn_sssr_bnd =   4.e0    !  ABS(Max/Min) value of the damping erp term [mm/day]
   nn_sssr_ice =   1       ! control of sea surface restoring under sea-ice
   nn_sssr_ice_sal =   0       ! control of sea surface restoring under sea-ice for salinity
   cn_dir      = '/work/cmcc/cp1/CPS/CMCC-OIS2/inputdata/STATIC_DA_NEMO42/SST_EN4/'      !  root directory for the SST/SSS data location
   !___________!_________________________!___________________!___________!_____________!________!___________!__________________!__________!_______________!
   !           !  file name              ! frequency (hours) ! variable  ! time interp.!  clim  ! 'yearly'/ ! weights filename ! rotation ! land/sea mask !
   !           !                         !  (if <0  months)  !   name    !   (logical) !  (T/F) ! 'monthly' !                  ! pairing  !    filename   !
   sn_sst      = 'sst_esa'         ,        24    ,  'sst_deg',    .false.  , .false., 'daily'  , 'weights_esasst_orca025_bilin.nc'       ,    ''    ,     ''
   sn_sss      = 'sss_clim_m2' ,        -1    ,  'sss',    .true.   , .true. , 'yearly'  ,    'weights_clim2_orca025_bilin.nc'            ,    ''    ,     ''
/
!-----------------------------------------------------------------------
&namsbc_apr    !   Atmospheric pressure used as ocean forcing           (ln_apr_dyn =T)
!-----------------------------------------------------------------------
/
!-----------------------------------------------------------------------
&namsbc_wave   ! External fields from wave model                        (ln_wave=T)
!-----------------------------------------------------------------------
/
!-----------------------------------------------------------------------
&namberg       !   iceberg parameters                                   (default: OFF)
!-----------------------------------------------------------------------
   ln_icebergs = .false.      ! activate iceberg floats (force =F with "key_agrif")
/
!-----------------------------------------------------------------------
&namsbc_fwb    !   freshwater-budget adjustment                         (nn_fwb > 0)
!-----------------------------------------------------------------------
   rn_fwb0     = 0.0          ! Initial freshwater adjustment flux [kg/m2/s] (nn_fwb = 2)
/
